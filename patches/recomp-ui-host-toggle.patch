+// The host-owned checkbox (GameInfo.host_toggle_*). The value is the host's:
+// read on every draw, written back on every change.
+void draw_host_toggle_row(LauncherModel* m, const LauncherTheme& th) {
+    if (!m || !m->host_toggle_get || !m->host_toggle_label) return;
+    const float cb = ImGui::GetFrameHeight();   // a checkbox is square
+    row_label_right(m->host_toggle_label, th, cb);
+    if (m->host_toggle_help && m->host_toggle_help[0] && ImGui::IsItemHovered())
+        ImGui::SetTooltip("%s", m->host_toggle_help);
+    bool value = m->host_toggle_get() != 0;
+    if (ImGui::Checkbox("##host_toggle", &value) && m->host_toggle_set)
+        m->host_toggle_set(value ? 1 : 0);
+}
